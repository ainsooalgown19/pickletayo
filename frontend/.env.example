NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Browser-restricted Google Maps keys for facility address search and map selection.
# Enable Maps JavaScript API and Places API (New) in Google Cloud.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Server-only PostgreSQL URLs from Supabase Dashboard > Connect.
# Use the pooled URL at runtime and the direct URL for Prisma migrations.
DATABASE_URL=postgresql://runtime-pooler-connection
DIRECT_URL=postgresql://direct-database-connection

# Server-only. Required only by trusted administrator provisioning commands.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only Gmail SMTP delivery. Use a Google app password, never your normal password.
EMAIL_PROVIDER=gmail
GMAIL_USER=notifications@example.com
GMAIL_APP_PASSWORD=
EMAIL_FROM=PickleTayo <notifications@example.com>

# Protects the internal outbox delivery endpoint used by a scheduler.
NOTIFICATION_WORKER_SECRET=

# Passed to `pnpm admin:provision`; do not save real values in committed files.
ADMIN_EMAIL=admin@pickletayo.test
ADMIN_PASSWORD=
