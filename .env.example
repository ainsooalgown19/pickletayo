POSTGRES_DB=tarapickle
POSTGRES_USER=tarapickle
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
PICKLETAYO_JWT_SECRET=replace-with-at-least-32-random-characters
PICKLETAYO_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3005

# Local profile system administrator bootstrap. Keep real values in the ignored
# application-local-secrets.properties file, never in committed configuration.
PICKLETAYO_ADMIN_ENABLED=false
PICKLETAYO_ADMIN_EMAIL=admin@example.com
PICKLETAYO_ADMIN_PASSWORD=replace-with-a-strong-local-password
